# Leave the Supabase values empty to run Taktik in "local mode": everything is stored in the
# browser (localStorage) and real-time collaboration works between tabs of the same browser.

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for email notifications and the daily digest cron.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployment, used in emails and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email via Resend (optional)
RESEND_API_KEY=
EMAIL_FROM="Taktik <notifications@example.com>"

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Monitoring and analytics (optional)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
